---
---

<section class="relative pt-32 md:pt-40 overflow-hidden hero-section">
  <div class="container-custom relative z-10 mx-auto px-4 ">
    {/* Added container classes */}
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="slide-up" transition:animate="slide">
        {/* H1: Keeping the size you selected */}
        <h1
          class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-secondary-900 dark:text-white leading-tight"
        >
          Home Automation,<br />Redefined by <span
            class="text-primary-600 dark:text-primary-400">AI</span
          >.
        </h1>
        {/* Paragraph: Make it slightly smaller relative to H1 */}
        <p
          class="text-lg md:text-xl text-secondary-600 dark:text-secondary-300 mb-8 max-w-lg"
        >
          {/* Was text-xl, now text-lg md:text-xl */}
          Effortless control, enhanced security, and smarter living for your home.
          Discover custom home automation solutions designed to simplify daily routines
          and bring complete peace of mind.
        </p>
        <div class="flex flex-wrap gap-4">
          {/* Button: Ensure consistent text size */}
          <a
            href="https://demo.fosslink.in"
            target="_blank"
            rel="noopener noreferrer"
            class="demo-cta group relative inline-flex items-center justify-center gap-3 rounded-full border border-accent-800 bg-accent-800 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent-900/25 transition-all duration-300 hover:-translate-y-1 hover:border-secondary-800 hover:bg-secondary-800 hover:shadow-xl hover:shadow-secondary-950/35 active:scale-95 md:text-base"
          >
            <span class="relative flex h-7 w-7 items-center justify-center rounded-full bg-white/10 ring-1 ring-white/20 transition-all duration-300 group-hover:rotate-12 group-hover:scale-110 group-hover:bg-white group-hover:text-secondary-950">
              <svg
                class="ml-0.5 h-3.5 w-3.5 fill-current"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path d="M8 5.14v13.72a1 1 0 001.54.84l10.3-6.86a1 1 0 000-1.68L9.54 4.3A1 1 0 008 5.14Z" />
              </svg>
            </span>
            <span class="relative">Try the Demo</span>
            <svg
              class="relative h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>

      {/* Right Column: Video Embed */}
      <div class="relative fade-in" transition:animate="fade">
        {/* Container that enforces aspect ratio, rounding, shadow */}
        <div
          class="aspect-video w-full relative overflow-hidden rounded-xl shadow-xl"
        >
          <iframe
            src="https://player.vimeo.com/video/1081038681?badge=0&autopause=0&player_id=0&app_id=58479&autoplay=1&muted=1"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
            class="absolute inset-0 w-full h-full"
            title="Fosslink-Automation"
            loading="lazy"
          >
          </iframe>
        </div>
      </div>
    </div>
  </div>

  {/* Compatibility Logos Section Below Hero */}
  <div class="mt-10 w-full overflow-hidden" transition:animate="slide">
    <div class="relative bg-blue-200 dark:bg-blue-900 py-12 md:py-16">
      <div class="container-custom mx-auto px-4 ">
        {/* Background Circle */}
        {/* Section Heading */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          {/* Left Column: Heading */}
          <div>
            {/* H2: Make this smaller than H1 */}
            <h2
              class="text-2xl md:text-3xl font-bold text-blue-950 dark:text-blue-50"
            >
              {/* Was 3xl/4xl, now 2xl/3xl */}
              Compatible with Your <span
                class="bg-accent-400 px-2 py-1 text-black rounded"
                >Favorite</span
              > Smart Home Platforms
            </h2>
          </div>

          {/* Right Column: "WORKS WITH" Label + Logos + Button */}
          <div class="flex flex-col items-start md:items-end justify-center">
            {/* Paragraph Label: Keep small */}
            <p
              class="text-sm uppercase tracking-wider text-blue-800 dark:text-blue-200 font-semibold mb-4"
            >
              WORKS WITH
            </p>
            <div
              class="flex flex-wrap justify-start md:justify-end items-center gap-3 md:gap-4"
            >
              {/* Logos - Size controlled by h-* class, not text size */}
              <div
                class="flex items-center justify-center w-16 h-16 p-2 rounded-lg bg-white/60 dark:bg-white/10 backdrop-blur-sm group hover:bg-white/75 dark:hover:bg-white/20 transition-all duration-300"
                title="Google Home / Assistant"
              >
                <img
                  src="./integrations/google_assistant.svg"
                  alt="Google Home / Assistant Compatible"
                  class="max-w-full max-h-[60%] object-contain group-hover:scale-105 transition-transform duration-300 ease-in-out"
                  loading="lazy"
                  height="40"
                  width="40"
                />
              </div>
              <div
                class="flex items-center justify-center w-16 h-16 p-2 rounded-lg bg-white/60 dark:bg-white/10 backdrop-blur-sm group hover:bg-white/75 dark:hover:bg-white/20 transition-all duration-300"
                title="Apple Home"
              >
                <img
                  src="./integrations/apple_homekit.svg"
                  alt="Apple Home Compatible"
                  class="max-w-full max-h-[60%] object-contain group-hover:scale-105 transition-transform duration-300 ease-in-out"
                  loading="lazy"
                  height="40"
                  width="40"
                />
              </div>
              <div
                class="flex items-center justify-center w-16 h-16 p-2 rounded-lg bg-white/60 dark:bg-white/10 backdrop-blur-sm group hover:bg-white/75 dark:hover:bg-white/20 transition-all duration-300"
                title="Alexa"
              >
                {/* Changed title */}
                <img
                  src="./integrations/alexa.svg"
                  alt="Alexa Compatible"
                  class="max-w-full max-h-[60%] object-contain group-hover:scale-105 transition-transform duration-300 ease-in-out"
                  loading="lazy"
                  height="40"
                  width="40"
                />
              </div>

              {/* Button */}
              <a
                href="/integrations"
                class="inline-flex items-center justify-center w-16 h-16 bg-black/10 dark:bg-white/15 hover:bg-black/20 dark:hover:bg-white/25 rounded-lg text-blue-900 dark:text-blue-100 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-white/50 hover:scale-105"
                aria-label="See more integrations"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="w-6 h-6"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo-cta {
    isolation: isolate;
  }

  .demo-cta::before {
    position: absolute;
    z-index: -1;
    inset: -6px;
    border: 2px solid rgb(56 189 248 / 0.52);
    border-radius: inherit;
    content: "";
    box-shadow: 0 0 0 4px rgb(56 189 248 / 0.12);
    opacity: 0.72;
    animation: demo-cta-ring 2.8s ease-out infinite;
  }

  .demo-cta:hover {
    animation: demo-cta-hover 900ms ease-in-out infinite alternate;
  }

  .demo-cta:active {
    animation: demo-cta-press 180ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-cta,
    .demo-cta::before {
      animation: none;
      transition: none;
    }
  }

  @keyframes demo-cta-ring {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.98);
    }
    55% {
      opacity: 0;
      transform: scale(1.08);
    }
  }

  @keyframes demo-cta-hover {
    from {
      transform: translateY(-1px) rotate(-1deg);
    }
    to {
      transform: translateY(-4px) rotate(1deg);
    }
  }

  @keyframes demo-cta-press {
    0% {
      transform: scale(0.95);
    }
    70% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(0.98);
    }
  }
</style>
